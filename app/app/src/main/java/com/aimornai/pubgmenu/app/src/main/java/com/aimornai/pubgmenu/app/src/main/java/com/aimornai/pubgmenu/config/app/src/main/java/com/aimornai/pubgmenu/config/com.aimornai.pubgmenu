package com.aimornai.pubgmenu

import android.app.*
import android.content.Context
import android.content.Intent
import android.graphics.PixelFormat
import android.os.Build
import android.os.IBinder
import android.view.*
import android.widget.*
import androidx.core.app.NotificationCompat
import com.aimornai.pubgmenu.config.ConfigStore
import com.aimornai.pubgmenu.config.EspConfig
import com.aimornai.pubgmenu.esp.EspRenderService

class OverlayService : Service() {

    private lateinit var wm: WindowManager
    private lateinit var rootView: View
    private var cfg = EspConfig()

    override fun onBind(i: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        startForeground(1, notif())
        wm = getSystemService(Context.WINDOW_SERVICE) as WindowManager
        cfg = ConfigStore.load()
        rootView = buildMenu()
        val p = WindowManager.LayoutParams(
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
            else WindowManager.LayoutParams.TYPE_PHONE,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        ).apply { gravity = Gravity.TOP or Gravity.START; x = 40; y = 200 }
        wm.addView(rootView, p)
        pushAll()
    }

    private fun pushAll() {
        Native.setBool("esp", cfg.enabled)
        Native.setFloat("maxDistance", cfg.maxDistance)
        Native.setBool("visibleCheck", cfg.visibleCheck)
        Native.setBool("box", cfg.boxEnabled)
        Native.setInt("boxStyle", cfg.boxStyle)
        Native.setFloat("boxThickness", cfg.boxThickness)
        Native.setColor("boxColor", cfg.boxColor)
        Native.setBool("skeleton", cfg.skeletonEnabled)
        Native.setFloat("skeletonThickness", cfg.skeletonThickness)
        Native.setColor("skeletonColor", cfg.skeletonColor)
        Native.setBool("snapLines", cfg.snapLinesEnabled)
        Native.setBool("topLines", cfg.topLinesEnabled)
        Native.setColor("linesColor", cfg.linesColor)
        Native.setBool("name", cfg.nameEnabled)
        Native.setBool("distance", cfg.distanceEnabled)
        Native.setBool("healthBar", cfg.healthBarEnabled)
        Native.setBool("armorBar", cfg.armorBarEnabled)
        Native.setBool("weapon", cfg.weaponEnabled)
        Native.setBool("teamCheck", cfg.teamCheck)
        Native.setColor("infoTextColor", cfg.infoTextColor)
        Native.setInt("selectedBone", cfg.selectedBone)
        Native.setBool("fovCircle", cfg.fovCircleEnabled)
        Native.setFloat("fovRadius", cfg.fovRadius)
        Native.setColor("fovColor", cfg.fovColor)
        Native.setBool("itemEsp", cfg.itemEspEnabled)
        Native.setFloat("itemMaxDistance", cfg.itemMaxDistance)
        Native.setColor("itemColor", cfg.itemColor)
        Native.setBool("vehicleEsp", cfg.vehicleEspEnabled)
        Native.setBool("vehicleDistance", cfg.vehicleDistanceEnabled)
        Native.setColor("vehicleColor", cfg.vehicleColor)
        ConfigStore.save(cfg)
    }

    private fun buildMenu(): View {
        val ctx = this
        val scroll = ScrollView(ctx)
        val layout = LinearLayout(ctx).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(0xCC000000.toInt())
            setPadding(24, 24, 24, 24)
        }
        fun header(t: String) {
            layout.addView(TextView(ctx).apply {
                text = t; setTextColor(0xFF00FF88.toInt()); textSize = 14f
                setPadding(0, 16, 0, 4)
            })
        }
        fun toggle(title: String, get: () -> Boolean, set: (Boolean) -> Unit) {
            layout.addView(Switch(ctx).apply {
                text = title; setTextColor(0xFFFFFFFF.toInt()); isChecked = get()
                setOnCheckedChangeListener { _, v -> set(v); pushAll() }
            })
        }
        fun slider(title: String, min: Float, max: Float, get: () -> Float, set: (Float) -> Unit) {
            layout.addView(TextView(ctx).apply {
                text = "$title: ${get()}"; setTextColor(0xFFFFFFFF.toInt())
            })
            layout.addView(SeekBar(ctx).apply {
                this.max = 100
                progress = (((get() - min) / (max - min)) * 100).toInt()
                setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                    override fun onProgressChanged(s: SeekBar?, p: Int, u: Boolean) {
                        set(min + (max - min) * (p / 100f)); pushAll()
                    }
                    override fun onStartTrackingTouch(s: SeekBar?) {}
                    override fun onStopTrackingTouch(s: SeekBar?) {}
                })
            })
        }
        fun dropdown(title: String, items: Array<String>, get: () -> Int, set: (Int) -> Unit) {
            layout.addView(TextView(ctx).apply {
                text = title; setTextColor(0xFFFFFFFF.toInt())
            })
            layout.addView(Spinner(ctx, Spinner.MODE_DROPDOWN).apply {
                adapter = ArrayAdapter(ctx, android.R.layout.simple_spinner_dropdown_item, items)
                setSelection(get())
                onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
                    override fun onItemSelected(p: AdapterView<*>?, v: View?, pos: Int, id: Long) {
                        set(pos); pushAll()
                    }
                    override fun onNothingSelected(p: AdapterView<*>?) {}
                }
            })
        }

        layout.addView(TextView(ctx).apply {
            text = "@AiMornAi ESP"; setTextColor(0xFF00FF88.toInt()); textSize = 18f
        })

        header("MAIN")
        toggle("ESP ON", { cfg.enabled }) { cfg.enabled = it }
        slider("Max distance", 50f, 1000f, { cfg.maxDistance }) { cfg.maxDistance = it }
        toggle("Visible check", { cfg.visibleCheck }) { cfg.visibleCheck = it }
        toggle("Team check", { cfg.teamCheck }) { cfg.teamCheck = it }

        header("BOX")
        toggle("Box", { cfg.boxEnabled }) { cfg.boxEnabled = it }
        dropdown("Box style", arrayOf("2D", "3D", "Corner"), { cfg.boxStyle }) { cfg.boxStyle = it }
        slider("Box thickness", 0.5f, 5f, { cfg.boxThickness }) { cfg.boxThickness = it }

        header("SKELETON")
        toggle("Skeleton", { cfg.skeletonEnabled }) { cfg.skeletonEnabled = it }
        slider("Skeleton thickness", 0.5f, 5f, { cfg.skeletonThickness }) { cfg.skeletonThickness = it }

        header("LINES")
        toggle("Snap lines", { cfg.snapLinesEnabled }) { cfg.snapLinesEnabled = it }
        toggle("Top lines", { cfg.topLinesEnabled }) { cfg.topLinesEnabled = it }

        header("INFO")
        toggle("Name", { cfg.nameEnabled }) { cfg.nameEnabled = it }
        toggle("Distance", { cfg.distanceEnabled }) { cfg.distanceEnabled = it }
        toggle("Health bar", { cfg.healthBarEnabled }) { cfg.healthBarEnabled = it }
        toggle("Armor bar", { cfg.armorBarEnabled }) { cfg.armorBarEnabled = it }
        toggle("Weapon", { cfg.weaponEnabled }) { cfg.weaponEnabled = it }

        header("BONE")
        dropdown("Selected bone", arrayOf("Head", "Neck", "Chest", "Pelvis"),
            { cfg.selectedBone }) { cfg.selectedBone = it }

        header("FOV")
        toggle("FOV circle", { cfg.fovCircleEnabled }) { cfg.fovCircleEnabled = it }
        slider("FOV radius", 50f, 500f, { cfg.fovRadius }) { cfg.fovRadius = it }

        header("ITEM / VEHICLE")
        toggle("Item ESP", { cfg.itemEspEnabled }) { cfg.itemEspEnabled = it }
        slider("Item max dist", 50f, 500f, { cfg.itemMaxDistance }) { cfg.itemMaxDistance = it }
        toggle("Vehicle ESP", { cfg.vehicleEspEnabled }) { cfg.vehicleEspEnabled = it }
        toggle("Vehicle distance", { cfg.vehicleDistanceEnabled }) { cfg.vehicleDistanceEnabled = it }

        header("ACTIONS")
        layout.addView(Button(ctx).apply {
            text = "Start ESP Layer"
            setOnClickListener {
                val i = Intent(ctx, EspRenderService::class.java)
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) ctx.startForegroundService(i)
                else ctx.startService(i)
            }
        })
        layout.addView(Button(ctx).apply {
            text = "Save config"
            setOnClickListener { ConfigStore.save(cfg); Toast.makeText(ctx, "saved", Toast.LENGTH_SHORT).show() }
        })
        layout.addView(Button(ctx).apply {
            text = "Close"
            setOnClickListener { stopSelf() }
        })

        scroll.addView(layout)
        return scroll
    }

    override fun onDestroy() {
        try { wm.removeView(rootView) } catch (_: Throwable) {}
        super.onDestroy()
    }

    private fun notif(): Notification {
        val ch = NotificationChannel("aim", "aim", NotificationManager.IMPORTANCE_LOW)
        (getSystemService(NOTIFICATION_SERVICE) as NotificationManager).createNotificationChannel(ch)
        return NotificationCompat.Builder(this, "aim")
            .setContentTitle("PUBG Menu").setSmallIcon(android.R.drawable.ic_menu_view).build()
    }
}
